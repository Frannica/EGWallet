# EAS Build ignore file — reduces upload size
# Documentation and markdown
*.md
*.txt
!README.md

# Git history and GitHub CI files (not needed for builds, cause tar errors on Linux)
.git
.git/**
.github
.github/**

# Backend (separate service, not part of the app)
backend/

# Test files
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
jest.config.cjs

# Keystore backup (sensitive, not needed on EAS)
keystore-backup/

# EAS build artifacts
*.apk
*.aab
*.ipa

# Local native/build caches (Windows paths break Linux EAS builders)
android/app/build/
android/build/
android/.gradle/
**/.cxx/
**/build/intermediates/
_export_audit/
_gradle_out*.txt
_eas_*.txt
_eas_*.json
_frontend_test_out.txt
_backend_test_out.txt
_admin_ui_out.txt
_export_out.txt

# Logs
backend/logs/
