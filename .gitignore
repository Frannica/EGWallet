# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# Service account credentials - NEVER commit these
service-account-key.json
*-service-account*.json
google-services.json

# typescript
*.tsbuildinfo

# npm backup files
package.json.*[^n]
!package.json

# build inspect and log files
build_latest*.json
build_log_latest_*.txt

# generated native folders
/ios
/android

# APK/AAB build artifacts - never commit compiled app binaries
*.apk
*.aab

# Live database and backups - never commit; contains password hashes, encrypted PII, tokens
backend/db.json
backend/db.json.bak
backend/db.json.corrupt.*
backend/db.json.tmp
backend/db/backups/

# Runtime logs - may contain sensitive request data
backend/logs/*.log
logs/

# Keystore backup folder - credentials must never be in git
keystore-backup/credentials.md
keystore-backup/README.md
keystore-backup/*.jks
keystore-backup/*.p12

# Temporary audit/debug files
backend/db-audit-temp.json
backend/db-audit-*.json

# Release hygiene: ad-hoc investigation/proof/debug artifacts generated
# during development and production verification sessions. These are
# intentionally untracked scratch files (audit logs, test-run captures,
# extracted APK contents, EAS build blobs, production diagnostic scripts)
# and must never be committed or shipped in a release. Single-underscore-
# prefixed files/folders are this project's convention for disposable
# scratch output — matched at ANY depth (not just repo root), since ad-hoc
# scripts are frequently dropped into backend/, backend/admin-dashboard/,
# and scripts/ during live debugging sessions.
#
# IMPORTANT: this must NOT match double-underscore-prefixed names like
# __tests__/, __mocks__/, __snapshots__/ — those are real Node/Jest testing
# conventions, not scratch output. `_[!_]*` requires a single leading
# underscore followed by a non-underscore character, so "_foo" matches but
# "__tests__" does not. (A plain `_*` previously matched here too, which
# silently gitignored real test files added under __tests__/.)
_[!_]*
!backend/admin-dashboard/public/_redirects
proof/
_device_apk/
_device_apk_extract/
_device_flow5_proof/
_eas_inspect/
_export_probe/
_export_probe2/
_preview_extract/
_v83_extracted/
_v84_extract/
*_proof.json
*_proof.txt
*-proof.txt
*-proof.json
*-proof-*.json
*.proof.json
db.proof-test.json

# Ad-hoc extracted / decompiled APK contents and build tooling
_bundletool.jar
*.jsbundle.js
out.jsbundle.js

# Root-level test-run captures / log dumps produced by manual verification
# runs (proper backend runtime logs are already covered by backend/logs/*.log
# and logs/ above) — these are one-off `node --test ... > *.txt/.log` captures.
/*.log
/*_run.log
/*_test_run.log

# Case-insensitive PROOF documents (e.g. FORGOT_PASSWORD_PROOF.txt,
# ADMIN_PLATFORM_PROOF.txt) and one-off build/EAS/gradle/sentry-upload
# captures at the repo root — same ad-hoc verification-session artifacts as
# above, just with an ALL-CAPS or non-"_proof.txt"-suffixed naming style
# that the earlier patterns don't match.
/*PROOF*.txt
/*PROOF*.md
/STATUS_REPORT.txt
/BUILD_TIMESTAMP.txt
/build_log_v*.txt
/build_with_sentry_*.txt
/eas_build_*.txt
/sentry_manual_upload_log.txt
/bugreport-*.zip
/run-all-fixed.js
__tests__/run-all-fixed.js

# One-off root-level Python/PowerShell scratch scripts used to hand-patch
# src/i18n/translations.ts or probe production during past debugging
# sessions. This project has no legitimate root-level Python scripts.
/*.py
/_smoke_test.ps1
/fx_test.ps1
