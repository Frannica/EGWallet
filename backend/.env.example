# ====================
# Server Configuration
# ====================
NODE_ENV=development
PORT=4000

# ====================
# Security
# ====================
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_in_production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# ====================
# Freshdesk Integration
# ====================
FRESHDESK_DOMAIN=yourdomain.freshdesk.com
FRESHDESK_API_KEY=your_freshdesk_api_key_here
FRESHDESK_EMAIL_CONFIG_ID=default

# ====================
# Stripe Payments
# ====================
# Get keys from https://dashboard.stripe.com/apikeys
# Leave blank to run in demo mode (Expo Go compatible, no real card charged)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks → endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Stripe Issuing (virtual cards) — requires Issuing enabled on your Stripe account.
# STRIPE_ISSUING_ENABLED gates webhook processing (stripeIssuing.js) for real
# Stripe Issuing authorization/transaction/card events.
STRIPE_ISSUING_ENABLED=false
# Set true to also log approved pending authorizations (captures still recorded via issuing_transaction.created)
STRIPE_ISSUING_RECORD_PENDING_AUTHS=false
# VIRTUAL_CARD_ISSUING_ENABLED gates the /virtual-cards creation/list/freeze API
# routes in index.js. MUST stay "false" — provisionVirtualCardForUser() currently
# only fabricates a local placeholder card number/CVV; it does NOT call Stripe's
# cardholder/card-creation APIs. Do not set this true until real Stripe Issuing
# cardholder + card provisioning is implemented end to end (see stripeIssuing.js
# header comment and the Phase 5 virtual-card report). Enabling it today would
# ship a non-functional fake card to users.
VIRTUAL_CARD_ISSUING_ENABLED=false

# Stripe Connect (Express accounts — US/UK/EU withdrawal corridors)
# MUST remain "false" until Stripe has explicitly approved EGWallet's stored-value
# P2P wallet business model on this account (see stripeConnect.js header comment).
# Leaving this false makes every Connect code path fully inert at runtime.
STRIPE_CONNECT_ENABLED=false
# Comma-separated ISO-2 country codes Stripe has explicitly approved for Connect
# payouts on this account, e.g. "US,GB,IE,DE,FR". Empty/unset = no country routes
# to Stripe Connect even if STRIPE_CONNECT_ENABLED=true.
STRIPE_CONNECT_APPROVED_COUNTRIES=
# Separate webhook destination from STRIPE_WEBHOOK_SECRET — register a second
# "Connect" webhook (not "Account") in the Stripe Dashboard pointed at
# https://<your-host>/webhooks/stripe-connect and paste its signing secret here.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_connect_webhook_signing_secret_here
# Return/refresh URLs for Stripe-hosted onboarding (deep links back into the app).
STRIPE_CONNECT_RETURN_URL=egwallet://stripe-connect/return
STRIPE_CONNECT_REFRESH_URL=egwallet://stripe-connect/refresh

# ====================
# Kora Payments (production payout provider for African countries)
# ====================
# Get keys from https://merchant.korapay.com → Settings → API Configuration
# Withdrawals to African countries (NG, GH, KE, CM, SN, CI, ZA, etc.) route through Kora;
# all other countries route through Stripe. Deposits always use Stripe. See payoutProviders.js.
# Leave blank to run in demo mode outside production (NODE_ENV!=production).
KORA_LIVE_PUBLIC_KEY=pk_live_your_kora_live_public_key_here
KORA_LIVE_SECRET_KEY=sk_live_your_kora_live_secret_key_here
# Optional: enables AES-256-GCM request payload encryption. Must be exactly 32 bytes.
KORA_LIVE_ENCRYPTION_KEY=your_32_byte_kora_encryption_key_here
# NOTE: Kora does NOT issue a separate webhook-signing secret — there is no
# KORA_WEBHOOK_SECRET var. Webhook payloads are signed with the same
# KORA_LIVE_SECRET_KEY above (HMAC-SHA256 of the `data` object; see
# https://developers.korapay.com/docs/webhooks). You only need to set the
# webhook URL itself on the Kora dashboard: Settings → API Configuration →
# Notification URLs → https://<your-host>/webhooks/kora

# ====================
# Rate Limiting
# ====================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AI_CHAT_RATE_LIMIT=10
AUTH_RATE_LIMIT=5

# ====================
# Logging
# ====================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
AUDIT_LOG_PATH=./logs/audit.log
ERROR_LOG_PATH=./logs/error.log

# ====================
# CORS
# ====================
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081,exp://192.168.1.100:19000

# ====================
# Security Headers
# ====================
ENABLE_HELMET=true
ENABLE_STRICT_CSP=false

# ====================
# Database
# ====================
DB_FILE_PATH=./db.json
DB_BACKUP_PATH=./db.json.bak
AUTO_BACKUP_INTERVAL_MS=3600000

# PostgreSQL Phase 0 tooling (schema/import/parity only)
# Do not switch runtime persistence in Phase 0.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/egwallet_phase0
PG_POOL_MAX=10
PGSSLMODE=disable

# ====================
# Audit & Compliance
# ====================
ENABLE_AUDIT_LOGS=true
MAX_AUDIT_LOGS_MEMORY=10000
ENABLE_GDPR_FEATURES=true

# ====================
# Fraud Detection
# ====================
FRAUD_VELOCITY_THRESHOLD=5
FRAUD_AMOUNT_THRESHOLD_USD=1000
FRAUD_TIME_WINDOW_MS=3600000
ENABLE_VELOCITY_CHECKS=true

# ====================
# Email Configuration
# ====================
EMAIL_FROM=noreply@egwallet.com
EMAIL_SUPPORT=SUPPORT@EGWALLETFINANCE.COM
EMAIL_SECURITY=security@egwallet.com
EMAIL_COMPLIANCE=compliance@egwallet.com

# Password reset email (required for Forgot Password to deliver mail)
# Option A — Resend HTTP API (recommended for Railway; set RESEND_API_KEY on Railway)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=EGWallet <noreply@yourdomain.com>
APP_FRONTEND_URL=egwallet://reset-password

# Option B — any SMTP provider (SendGrid, Mailgun, Brevo, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key_here
# SMTP_FROM=EGWallet <no-reply@yourdomain.com>
# SMTP_SECURE=false

# Option C — Gmail app password
# GMAIL_USER=egwallet.business@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password

# ====================
# Webhooks
# ====================
WEBHOOK_SECRET=your_webhook_secret_key_here
ENABLE_WEBHOOK_VALIDATION=true

# ====================
# Firebase Admin SDK
# ====================
# For LOCAL DEV: leave blank — the SDK reads ../service-account-key.json automatically
# For PRODUCTION / Railway: paste the ENTIRE contents of service-account-key.json as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional: Realtime Database URL (only needed if you use Realtime DB, not Firestore)
FIREBASE_DATABASE_URL=

# ====================
# Feature Flags
# ====================
# Closed-testing only: permit demo deposit intents in production when Stripe is not configured.
ALLOW_DEMO_DEPOSITS=false
ENABLE_2FA=true
ENABLE_BIOMETRIC=true
ENABLE_AUTO_FRAUD_DETECTION=true
ENABLE_TRANSACTION_REVERSAL=true

# ====================
# Monitoring & Health
# ====================
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_INTERVAL_MS=60000
